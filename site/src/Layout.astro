---
import type { MarkdownHeading } from "astro";
import { withBase, repositoryURL } from "./links.mjs";
import styles from "./style.css?url";
import GithubIcon from "./GithubIcon.astro";
import TableOfContents from "./TableOfContents.astro";
import { buildToc } from "./toc.mjs";

interface Props {
  title: string;
  headings: MarkdownHeading[];
  source: string;
}
const { title, headings, source } = Astro.props;
const base = import.meta.env.BASE_URL;
const groups = [
  { title: "Guides", links: [
    ["Getting started", ""],
    ["Text and structured output", "guides/client/"],
    ["Decisions", "guides/decisions/"],
    ["Cookbook", "guides/cookbook/"],
  ] },
  { title: "Reference", links: [
    ["API reference", "api/"],
    ["HTTP transport", "guides/transport/"],
    ["Sessions and providers", "guides/api/"],
    ["Architecture", "guides/architecture/"],
  ] },
];
const sections = buildToc(headings);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Structured extraction and typed model decisions in Zig." />
    <title>{title === "instructor.zig" ? title : `${title} · instructor.zig`}</title>
    <link rel="stylesheet" href={withBase("missing.css", base)} />
    <link rel="stylesheet" href={styles} />
    <link rel="icon" type="image/svg+xml" href={withBase("favicon-braces.svg", base)} />
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <header class="site-header">
      <div class="header-inner">
        <a class="wordmark" href={withBase("", base)}>instructor.zig</a>
        <nav aria-label="Project">
          <a class="project-link" href={withBase("api/", base)} aria-label="API reference">
            <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M12 5c-3-2-7-2-10-1v15c3-1 7-1 10 1 3-2 7-2 10-1V4c-3-1-7-1-10 1Zm0 0v15"/></svg>
            <span class="header-label">API reference</span>
          </a>
          <a class="project-link" href={repositoryURL} aria-label="GitHub"><GithubIcon /><span class="header-label">GitHub</span></a>
        </nav>
      </div>
    </header>
    <div class="docs-layout">
      <aside class="sidebar">
        <nav class="docs-nav" aria-label="Documentation">
          {groups.map((group) => <div class="nav-group">
            <p class="nav-title">{group.title}</p>
            <ul>{group.links.map(([label, path]) => <li>
              <a href={withBase(path, base)} aria-current={Astro.url.pathname === withBase(path, base) ? "page" : undefined}>{label}</a>
            </li>)}</ul>
          </div>)}
        </nav>
      </aside>
      <main id="content">
        <article><slot /></article>
        <footer><a href={`${repositoryURL}/blob/main/${source}`}>Page source</a><span><a href="https://astro.build/">Astro</a> · <a href="https://missing.style/">missing.css</a></span></footer>
      </main>
      {sections.length > 0 && <aside class="page-toc" aria-label="On this page">
        <p class="nav-title">On this page</p>
        <nav><TableOfContents items={sections} /></nav>
      </aside>}
    </div>
    <span class="visually-hidden" id="copy-status" role="status" aria-live="polite"></span>
    <script src="./copy-code.js"></script>
  </body>
</html>
